{
  "name": "@plancraft/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "dev": "concurrently \"npm run start:web\" \"wait-on http://localhost:3000 && electron .\"",
    "start:web": "cd ../web && next dev",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "dependencies": {
    "electron-is-dev": "^3.0.0",
    "koffi": "^2.9.0",
    "next": "^16.2.9"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^42.5.1",
    "electron-builder": "^26.15.3",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.plancraft.app",
    "productName": "PlanCraft",
    "protocols": [
      {
        "name": "Crecoard",
        "schemes": ["crecoard"]
      }
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.ico"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "assets/icon.png",
      "category": "Utility"
    }
  }
}
