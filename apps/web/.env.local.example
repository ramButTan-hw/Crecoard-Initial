# ─── Supabase ────────────────────────────────────────────────────────────────
# Both values are safe to expose in the browser (they are public by design).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# NEVER add SUPABASE_SERVICE_ROLE_KEY here or expose it to the client.
# The service role key bypasses all Row Level Security policies.
# Use it only in trusted server-side code (Edge Functions, secure API routes)
# and never prefix it with NEXT_PUBLIC_.

# ─── YouTube Data API ────────────────────────────────────────────────────────
# Used server-side only (playlist import route).
# NEVER prefix with NEXT_PUBLIC_ — exposing this key allows quota abuse.
YOUTUBE_API_KEY=your-youtube-api-key
